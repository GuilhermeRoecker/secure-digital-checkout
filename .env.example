ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
PORT=3000
# Configure uma URL de callback acessível pelo Asaas Sandbox; localhost é rejeitado.
APP_BASE_URL=
# Token independente da API key: 32–255 caracteres sem espaços, igual ao Auth Token do webhook.
ASAAS_WEBHOOK_TOKEN=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=secure_checkout
# Somente se cloudflared roda no mesmo host e alcança Node por loopback.
# Autoriza CF-Connecting-IP e X-Forwarded-Proto apenas desse peer local.
DIRECT_PAYMENT_TRUST_CLOUDFLARE=false
